# voyage-coms.ru — приложение звонков в корне (за Cloudflare)
server {
    listen 80;
    server_name voyage-coms.ru www.voyage-coms.ru turn.voyage-coms.ru;
    location /.well-known/acme-challenge/ { root /var/www/voyage-coms/dist; }
    location / { return 301 https://voyage-coms.ru$request_uri; }
}
server {
    listen 443 ssl;
    server_name voyage-coms.ru www.voyage-coms.ru;

    ssl_certificate /etc/letsencrypt/live/voyage-coms.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/voyage-coms.ru/privkey.pem;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    root /var/www/voyage-coms/dist;
    index index.html;

    location /socket.io/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
    location /rooms { proxy_pass http://127.0.0.1:4000; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; }
    location /contacts { proxy_pass http://127.0.0.1:4000; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; }
    location /recordings/ { proxy_pass http://127.0.0.1:4000/recordings/; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; }
    # Записи отдаются только по подписанной ссылке с ограниченным сроком жизни.
    # Ссылку выдаёт авторизованный роут GET /recordings/:id/link.
    # __REC_LINK_SECRET__ подставить вручную: он должен совпадать со значением
    # REC_LINK_SECRET в /var/www/voyage/server/.env (в git секрет не хранится).
    location /recfiles/ {
        secure_link $arg_md5,$arg_e;
        secure_link_md5 "$secure_link_expires$uri __REC_LINK_SECRET__";
        if ($secure_link = "")  { return 403; }
        if ($secure_link = "0") { return 410; }
        alias /var/www/voyage/recordings/;
        add_header Content-Disposition 'attachment';
    }
    location /uploads/ { alias /var/www/voyage/uploads/; expires 7d; add_header Cache-Control public; }
    location /auth/ {
        limit_req zone=authzone burst=15 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:4000/auth/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location /livekit/ {
        proxy_pass http://127.0.0.1:7880/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
        proxy_cache off;
    }
    location / { try_files $uri $uri/ /index.html; }
}
